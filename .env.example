# Optional: raises GitHub API rate limit 60/hr -> 5000/hr for the repos feed.
# Create at https://github.com/settings/tokens — needs NO scopes (public data only).
GITHUB_TOKEN=

# Canonical site URL used for metadata/OG/sitemap (defaults to morkie.is-a.dev).
NEXT_PUBLIC_SITE_URL=https://morkie.is-a.dev
